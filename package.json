{
  "name": "dsh-connect-qoder",
  "version": "0.3.0",
  "type": "module",
  "description": "Brings the signed-in Qoder desktop apps (CN and global) into DSH as model providers, with a sidebar panel.",
  "displayName": "Qoder",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bubble-xd/dsh-connect-qoder.git"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "qoder", "model-provider"],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@qoder-ai/qoder-agent-sdk": "1.0.60",
    "@qodercn-ai/qodercn-agent-sdk": "1.0.59",
    "zod": "^4.0.0"
  },
  "files": [
    "lib/*.js",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
